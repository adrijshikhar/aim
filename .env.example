# AIM Environment Configuration (Optional)
#
# Base directory for AIM configuration and profiles (default: ~/.aim)
# AIM_HOME=~/.aim

# Real user home directory (default: inferred from $HOME or os.UserHomeDir)
# AIM_REAL_HOME=~

# Active profile and agent override (normally set by AIM during launch)
# AIM_PROFILE=work
# AIM_AGENT=agy

# Antigravity OAuth client credentials override (optional)
# AIM_AGY_CLIENT_ID=
# AIM_AGY_CLIENT_SECRET=
